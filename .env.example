# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenAI
LLM_API_KEY=sk-...
LLM_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-4o-mini

# Option B: IBM watsonx (comment out Option A and uncomment these)
# LLM_API_KEY=your-ibm-cloud-api-key
# LLM_BASE_URL=https://us-south.ml.cloud.ibm.com/ml/v1/openai
# LLM_MODEL=ibm/granite-3-8b-instruct

# ── Optional ──────────────────────────────────────────────────────────────────
# LLM_TIMEOUT=60
