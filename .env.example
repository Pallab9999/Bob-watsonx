# Copy this file to .env and fill in your values
# cp .env.example .env

# ── LLM Provider ──────────────────────────────────────────────────────────────
# Option A: OpenAI
# LLM_API_KEY=sk-...
# LLM_BASE_URL=https://api.openai.com/v1
# LLM_MODEL=gpt-4o-mini

# Option B: IBM watsonx (comment out Option A and uncomment these)
#
# LLM_API_KEY is your IBM Cloud API key (NOT a watsonx API key).
# The server automatically exchanges it for an IAM bearer token.
#
# LLM_BASE_URL must be the bare host — do NOT include /ml/v1 or /openai.
# The server constructs the correct path: /ml/v1/text/chat?version=...
#
# Find WATSONX_PROJECT_ID in your watsonx.ai project → Manage → General.
LLM_API_KEY=l7AwhnOmOUcNtX7KE7IsJOx_EWGN9vEK6LAjdwsUXPEr
LLM_BASE_URL=https://us-south.ml.cloud.ibm.com
LLM_MODEL=ibm/granite-3-8b-instruct
WATSONX_PROJECT_ID=your-watsonx-project-id-here

# ── Optional ──────────────────────────────────────────────────────────────────
# LLM_TIMEOUT=60
# WATSONX_API_VERSION=2023-05-29
